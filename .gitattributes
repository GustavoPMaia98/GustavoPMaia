# Keep line endings consistent between Windows (GitHub Desktop) and the
# nightly publications bot (Linux). Text files are stored and checked out
# with LF everywhere, so no file flips between CRLF and LF.
* text=auto eol=lf

# Binary files: never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
.thumbnail binary
